{
  "extends": "@zphyrx/typescript-config/dom/app",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "../*": ["./src/*"]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

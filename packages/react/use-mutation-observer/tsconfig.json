{
  "extends": "@zphyrx/typescript-config/dom/monorepo",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist/esm",
    "allowJs": false,
    "jsx": "react-jsx"
  },
  "include": ["src", "**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "dist"]
}
